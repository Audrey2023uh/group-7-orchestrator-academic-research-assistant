# Copy to .env and fill locally. Never commit real secrets.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=academic-research-orchestrator
USE_MOCK_LLM=true
# Optional: absolute path for SQLite long-term memory (defaults to data/memory.db)
# MEMORY_DB_PATH=
# Live app port (webapp.py / Docker)
PORT=7860
TARGET_REVIEWERS=20
