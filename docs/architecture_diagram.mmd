flowchart TB
  SHARED["Shared Contract: contract.py · AgentState"]

  subgraph UNIFIED["Unified Multi-Agent System — main_system.py"]
    direction TB

    subgraph GLOBAL["Global Cross-Cutting Guardrails"]
      direction LR
      PRIV["G5 Privacy Redaction<br/>redact_for_telemetry()"]
      CTX["G6 Context / Token Management<br/>manage_context()"]
    end

    C["0. Central Coordinator<br/>Dynamic State Routing"]

    C -->|"route=analyze<br/>missing analysis_payload"| A
    C -->|"route=review<br/>reviewer_index &lt; 20"| B
    C -->|"route=validate<br/>reviews complete"| V
    C -->|"route=report<br/>is_validated"| R
    C -->|"round_number &gt;= max_rounds<br/>G1 loop termination"| P

    A["1. Worker A: Analyzer<br/>G2 Offline Structured-Output Double<br/>+ Schema Validation + 1 Correction Retry"]
    B["2. Worker B: Actor<br/>Independent Reviewer ×20 isolated<br/>G3 Tool Allowlist"]
    V["3. Worker C: Validator<br/>G4 State Sanitization + Invariants<br/>+ rejection_flag"]
    R["4. Worker D: Reporter / Meta-Analyst"]
    P["Partial Output Node<br/>Graceful Max-Round Stop G1"]

    A -->|"return + redact + manage_context"| C
    B -->|"return + redact + manage_context"| C
    V -->|"accept → Coordinator"| C
    V -->|"rejection_flag"| RB

    RB["Loop / Self-Correction<br/>round_number++ · re-route to Analyzer<br/>routing logic inside Coordinator<br/>not a separate graph node"]
    RB -->|"self-correction retry<br/>if round_number &lt; max_rounds"| C
    RB -->|"retry budget exhausted"| P

    R --> ENDN(["END"])
    P --> ENDN
  end

  SHARED -.-> C
  GLOBAL -.-> A
  GLOBAL -.-> B
  GLOBAL -.-> V
  GLOBAL -.-> R
  GLOBAL -.-> C
